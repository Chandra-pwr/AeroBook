import React, { useState } from 'react';
import {
  Plane, Globe2, Search, CalendarDays, Users, MapPin,
  ArrowLeftRight, ChevronDown, Ticket, Menu, X, Compass
} from 'lucide-react';
import './App.css';

export default function App() {
  const [origin, setOrigin] = useState('DEL');
  const [dest, setDest] = useState('BOM');
  const [departureDate, setDepartureDate] = useState('');
  const [returnDate, setReturnDate] = useState('');
  const [tripType, setTripType] = useState('Round trip');
  const [passengers, setPassengers] = useState('1 Adult');
  const [travelClass, setTravelClass] = useState('Economy');
  const [flights, setFlights] = useState([]);
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);
  const [searched, setSearched] = useState(false);
  const [menuOpen, setMenuOpen] = useState(false);

  async function searchFlights(event) {
    event.preventDefault();
    setLoading(true);
    setError('');
    setFlights([]);
    setSearched(false);

    try {
      const response = await fetch(
        `/api/flights/search?origin=${encodeURIComponent(origin.trim().toUpperCase())}&destination=${encodeURIComponent(dest.trim().toUpperCase())}`
      );
      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Flight search failed');
      }

      setFlights(data.flights || []);
      setSearched(true);

      if (data.demo) {
        setError('Showing demo flights. These are sample results, not live airline availability.');
      }
    } catch (err) {
      setError(err.message || 'Unable to search flights. Please try again.');
    } finally {
      setLoading(false);
    }
  }

  function swapAirports() {
    setOrigin(dest);
    setDest(origin);
  }

  return (
    <div className="aero-app">
      <div className="page-shell">
        <header className="topbar">
          <a className="brand" href="/" aria-label="AeroBook home">
            <span className="brand-mark"><Plane size={23} fill="currentColor" /></span>
            <span>Aero<span>Book</span></span>
          </a>

          <button className="mobile-menu" onClick={() => setMenuOpen(!menuOpen)} aria-label="Toggle menu">
            {menuOpen ? <X /> : <Menu />}
          </button>

          <nav className={menuOpen ? 'nav-links nav-open' : 'nav-links'}>
            <a className="nav-active" href="#home" onClick={() => setMenuOpen(false)}>Home</a>
            <a href="#booking" onClick={() => setMenuOpen(false)}>Book a flight</a>
            <a href="#destinations" onClick={() => setMenuOpen(false)}>Explore</a>
            <a href="#my-booking" onClick={() => setMenuOpen(false)}>My bookings</a>
          </nav>

          <div className="top-actions">
            <button className="language-button"><Globe2 size={17} /> EN <ChevronDown size={14} /></button>
            <a className="login-button" href="#my-booking">Sign in <span>↗</span></a>
          </div>
        </header>

        <main id="home">
          <section className="hero">
            <div className="hero-copy">
              <div className="eyebrow"><span className="eyebrow-dot" /> YOUR JOURNEY STARTS HERE</div>
              <h1>READY TO<br />TAKE <span>OFF?</span></h1>
              <p className="hero-description">
                The world is waiting. Find your next destination
                and turn your travel dreams into unforgettable memories.
              </p>
              <a className="primary-button" href="#booking">Explore flights <span>↗</span></a>

              <div className="flight-label">
                <span>FLY YOUR WAY</span>
                <i className="dot dot-purple" />
                <i className="dot dot-blue" />
                <i className="dot dot-orange" />
              </div>
            </div>

            <div className="hero-art" aria-label="Airplane travelling around the world">
              <div className="art-glow" />
              <div className="orbit orbit-one" />
              <div className="orbit orbit-two" />
              <div className="globe">
                <Globe2 className="globe-icon" strokeWidth={0.8} />
              </div>
              <div className="route-line" />
              <div className="route-point point-left" />
              <div className="route-point point-right" />
              <div className="route-caption caption-left"><strong>YOUR CITY</strong><span>Departure</span></div>
              <div className="route-caption caption-right"><strong>NEW PLACES</strong><span>Destination</span></div>
              <div className="plane-illustration"><Plane size={190} strokeWidth={1.15} /></div>
              <div className="art-sticker"><Compass size={17} /> THE WORLD IS YOURS</div>
            </div>

            <aside className="ticket-card">
              <div className="ticket-heading">
                <span className="ticket-icon"><Ticket size={19} /></span>
                <span>YOUR NEXT ADVENTURE</span>
              </div>
              <h2>Book flight<br />tickets</h2>
              <p>More destinations. More memories. One simple booking.</p>
              <div className="ticket-chip">✦ TRAVEL YOUR WAY</div>
              <div className="ticket-divider"><span /><span /></div>
              <div className="ticket-route">
                <div><small>FROM</small><strong>DEL</strong><span>New Delhi</span></div>
                <div className="mini-plane"><Plane size={20} /></div>
                <div className="ticket-destination"><small>TO</small><strong>BOM</strong><span>Mumbai</span></div>
              </div>
              <div className="barcode" aria-hidden="true" />
              <div className="ticket-footer"><span>AEROBOOK AIR</span><span>FLY BEYOND</span></div>
            </aside>
          </section>

          <section className="booking-area" id="booking">
            <div className="booking-heading">
              <div>
                <span className="section-kicker">LET'S GET YOU THERE</span>
                <h2>Find your next flight<span>.</span></h2>
              </div>
              <div className="secure-label"><span /> SIMPLE · FAST · SECURE</div>
            </div>

            <form className="search-panel" onSubmit={searchFlights}>
              <div className="search-options">
                <label className="select-option">
                  <Plane size={16} />
                  <select value={tripType} onChange={e => setTripType(e.target.value)} aria-label="Trip type">
                    <option>Round trip</option>
                    <option>One way</option>
                  </select>
                  <ChevronDown size={14} />
                </label>
                <label className="select-option">
                  <Users size={16} />
                  <select value={passengers} onChange={e => setPassengers(e.target.value)} aria-label="Passengers">
                    <option>1 Adult</option>
                    <option>2 Adults</option>
                    <option>3 Adults</option>
                    <option>4 Adults</option>
                    <option>Family</option>
                  </select>
                  <ChevronDown size={14} />
                </label>
                <label className="select-option">
                  <Ticket size={16} />
                  <select value={travelClass} onChange={e => setTravelClass(e.target.value)} aria-label="Travel class">
                    <option>Economy</option>
                    <option>Premium Economy</option>
                    <option>Business</option>
                    <option>First Class</option>
                  </select>
                  <ChevronDown size={14} />
                </label>
              </div>

              <div className="route-fields">
                <label className="route-field">
                  <span className="field-label"><MapPin size={14} /> FROM</span>
                  <input value={origin} onChange={e => setOrigin(e.target.value.toUpperCase())}
                    placeholder="DEL" maxLength={3} aria-label="Origin airport code" required />
                  <small>Origin airport code</small>
                </label>

                <button className="swap-button" type="button" onClick={swapAirports} aria-label="Swap airports">
                  <ArrowLeftRight size={18} />
                </button>

                <label className="route-field">
                  <span className="field-label"><MapPin size={14} /> TO</span>
                  <input value={dest} onChange={e => setDest(e.target.value.toUpperCase())}
                    placeholder="BOM" maxLength={3} aria-label="Destination airport code" required />
                  <small>Destination airport code</small>
                </label>

                <label className="date-field">
                  <span className="field-label"><CalendarDays size={14} /> DEPARTURE</span>
                  <input type="date" value={departureDate} onChange={e => setDepartureDate(e.target.value)} aria-label="Departure date" />
                </label>

                {tripType === 'Round trip' && (
                  <label className="date-field return-field">
                    <span className="field-label"><CalendarDays size={14} /> RETURN</span>
                    <input type="date" value={returnDate} min={departureDate || undefined}
                      onChange={e => setReturnDate(e.target.value)} aria-label="Return date" />
                  </label>
                )}

                <button className="search-button" type="submit" disabled={loading}>
                  {loading ? <span className="spinner" /> : <Search size={21} />}
                  <span>{loading ? 'Searching' : 'Search flights'}</span>
                </button>
              </div>
              <p className="search-note">Search by three-letter airport codes, for example DEL → BOM.</p>
            </form>
          </section>

          {error && (
            <div className={searched && flights.length > 0 ? 'notice notice-warn' : 'notice'} role="status">
              {error}
            </div>
          )}

          {searched && (
            <section className="results-section">
              <div className="results-heading">
                <div><span className="section-kicker">YOUR SEARCH</span><h2>{origin} <span>→</span> {dest}</h2></div>
                <span>{flights.length} result{flights.length !== 1 ? 's' : ''}</span>
              </div>
              {flights.length === 0 ? (
                <div className="empty-results">No flights found for this route. Try different airport codes.</div>
              ) : (
                <div className="results-grid">
                  {flights.map((flight) => (
                    <article className="result-card" key={flight.id}>
                      <div className="result-top">
                        <div className="airline-mark"><Plane size={20} /></div>
                        <div className="airline-name"><strong>{flight.airline}</strong><small>Flight {flight.id}</small></div>
                        <strong className="flight-price">₹{Number(flight.price).toLocaleString('en-IN')}</strong>
                      </div>
                      <div className="result-route">
                        <div><strong>{flight.departure}</strong><span>{flight.origin}</span></div>
                        <div className="route-middle"><span>✈</span><i /></div>
                        <div className="result-arrival"><strong>{flight.arrival}</strong><span>{flight.destination}</span></div>
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </section>
          )}

          <section className="explore-section" id="destinations">
            <div className="explore-copy">
              <span className="section-kicker">A WORLD OF POSSIBILITIES</span>
              <h2>Where will life<br />take you next?</h2>
              <p>Your next great story starts with a single flight.</p>
            </div>
            <div className="destination-card destination-delhi">
              <div className="destination-number">01 / INDIA</div>
              <div><span>THE CAPITAL</span><h3>New Delhi</h3></div>
              <span className="destination-arrow">↗</span>
            </div>
            <div className="destination-card destination-mumbai">
              <div className="destination-number">02 / INDIA</div>
              <div><span>THE CITY OF DREAMS</span><h3>Mumbai</h3></div>
              <span className="destination-arrow">↗</span>
            </div>
          </section>

          <section className="booking-help" id="my-booking">
            <div className="help-icon"><Ticket size={23} /></div>
            <div><h3>Your journey, all in one place.</h3><p>Need to check a reservation? Keep your trip details handy and check back for booking features.</p></div>
            <a href="#booking">Plan a trip <span>↗</span></a>
          </section>
        </main>

        <footer className="footer">
          <a className="brand footer-brand" href="#home"><span className="brand-mark"><Plane size={19} fill="currentColor" /></span><span>Aero<span>Book</span></span></a>
          <p>MADE FOR THE JOURNEY. BUILT FOR THE DESTINATION.</p>
          <span>© {new Date().getFullYear()} AeroBook</span>
        </footer>
      </div>
    </div>
  );
}
