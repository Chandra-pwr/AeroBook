@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --ink: #20203b;
  --muted: #77788f;
  --purple: #7257e8;
  --purple-dark: #5e43d0;
  --purple-pale: #f0edff;
  --line: #eceaf4;
  --surface: #ffffff;
  --page: #faf9ff;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 95px; }
body {
  margin: 0;
  background: var(--page);
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
}
button, input, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }
button { cursor: pointer; }
.travel-app { min-height: 100vh; overflow: hidden; }
.site-header {
  height: 82px;
  max-width: 1320px;
  padding: 0 42px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: 'Manrope', sans-serif;
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -1px;
  white-space: nowrap;
}
.brand-icon {
  display: grid;
  place-items: center;
  width: 39px;
  height: 39px;
  border-radius: 13px;
  color: white;
  background: linear-gradient(145deg, #9279ff, #6548d7);
  box-shadow: 0 7px 17px #7257e82b;
}
.brand-accent { color: var(--purple); }
.main-nav { display: flex; align-items: center; gap: 35px; }
.main-nav a { color: #77768c; font-size: 13px; font-weight: 600; transition: color .2s; }
.main-nav a:hover, .main-nav .nav-active { color: var(--purple); }
.header-actions { display: flex; align-items: center; gap: 23px; }
.login-link { font-size: 13px; font-weight: 700; }
.header-cta, .primary-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  border-radius: 12px;
  background: var(--purple);
  color: white;
  font-size: 13px;
  font-weight: 700;
  padding: 14px 19px;
  box-shadow: 0 8px 18px #7257e82b;
  transition: background .2s, transform .2s;
}
.header-cta:hover, .primary-button:hover, .search-button:hover { background: var(--purple-dark); transform: translateY(-1px); }
.mobile-menu-button { display: none; border: 0; background: transparent; color: var(--ink); }

.hero {
  max-width: 1320px;
  min-height: 480px;
  margin: 8px auto 0;
  padding: 43px 42px 54px;
  display: grid;
  grid-template-columns: .92fr 1.08fr;
  align-items: center;
  gap: 38px;
}
.hero-copy { position: relative; z-index: 2; padding: 8px 0 0; }
.eyebrow, .section-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--purple);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
}
.eyebrow {
  padding: 9px 13px;
  background: var(--purple-pale);
  border-radius: 30px;
}
.hero h1 {
  font-family: 'Manrope', sans-serif;
  font-size: clamp(39px, 4.15vw, 61px);
  line-height: 1.13;
  letter-spacing: -3.2px;
  margin: 22px 0 18px;
  font-weight: 800;
}
.hero h1 span {
  color: var(--purple);
  position: relative;
}
.hero-description {
  color: var(--muted);
  max-width: 425px;
  font-size: 14px;
  line-height: 1.9;
  margin: 0;
}
.hero-actions { display: flex; align-items: center; gap: 24px; margin-top: 27px; flex-wrap: wrap; }
.primary-button { padding: 16px 20px; border-radius: 13px; }
.hero-trust { display: flex; align-items: center; gap: 9px; }
.trust-icon { color: #45a78a; }
.hero-trust strong, .hero-trust small { display: block; }
.hero-trust strong { font-size: 11px; }
.hero-trust small { font-size: 10px; color: var(--muted); margin-top: 4px; }
.hero-stats {
  display: flex;
  gap: 28px;
  margin-top: 40px;
  padding-top: 22px;
  border-top: 1px solid #eae7f4;
  max-width: 445px;
}
.hero-stats div { display: flex; flex-direction: column; gap: 5px; }
.hero-stats strong { font-family: 'Manrope', sans-serif; font-size: 13px; }
.hero-stats span { color: var(--muted); font-size: 10px; }

.hero-visual { position: relative; min-width: 0; padding: 9px 10px 18px 15px; }
.hero-photo {
  height: 382px;
  position: relative;
  overflow: hidden;
  border-radius: 34px 34px 34px 110px;
  background: #dcd8f6;
  box-shadow: 0 24px 60px #4b3e8b1b;
}
.hero-photo img { height: 100%; width: 100%; object-fit: cover; display: block; }
.photo-gradient { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 48%, #151a35a8 100%); }
.photo-caption {
  position: absolute;
  bottom: 24px;
  left: 25px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: white;
}
.caption-icon {
  width: 43px; height: 43px; display: grid; place-items: center;
  background: #ffffff25; border: 1px solid #ffffff50;
  border-radius: 14px; backdrop-filter: blur(8px);
}
.photo-caption small, .photo-caption strong { display: block; }
.photo-caption small { font-size: 9px; letter-spacing: 1.6px; opacity: .85; }
.photo-caption strong { margin-top: 5px; font-size: 17px; font-family: 'Manrope', sans-serif; }
.floating-card {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 11px;
  background: white;
  padding: 13px 16px;
  border-radius: 16px;
  box-shadow: 0 12px 38px #34305420;
  z-index: 2;
}
.floating-card-top { top: 38px; left: -12px; }
.floating-card-bottom { right: -4px; bottom: 48px; }
.floating-icon { display: grid; place-items: center; width: 39px; height: 39px; background: var(--purple-pale); color: var(--purple); border-radius: 12px; }
.floating-card strong, .floating-card small { display: block; white-space: nowrap; }
.floating-card strong { font-size: 11px; }
.floating-card small { font-size: 10px; color: var(--muted); margin-top: 5px; }
.status-dot { width: 9px; height: 9px; border-radius: 50%; background: #39b48b; box-shadow: 0 0 0 5px #e5f7f0; margin: 0 6px; }
.hero-orbit { position: absolute; border: 1px solid #dcd5ff; border-radius: 50%; z-index: -1; }
.orbit-one { width: 95px; height: 95px; right: -10px; top: -22px; }
.orbit-two { width: 45px; height: 45px; left: -15px; bottom: -5px; }

.search-section {
  max-width: 1236px;
  margin: 0 auto;
  padding: 29px 31px 20px;
  background: white;
  border: 1px solid #efedf7;
  border-radius: 23px;
  box-shadow: 0 18px 60px #38305e0c;
  position: relative;
  z-index: 3;
}
.search-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 23px; }
.search-heading h2, .section-heading-row h2 {
  font-family: 'Manrope', sans-serif;
  font-size: 23px;
  letter-spacing: -.8px;
  margin: 7px 0 0;
}
.flight-tab {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--purple-pale); color: var(--purple);
  border-radius: 11px; padding: 11px 15px; font-size: 12px; font-weight: 700;
}
.flight-form { display: grid; grid-template-columns: 1fr 34px 1fr 1.15fr 1.15fr auto; align-items: center; gap: 12px; }
.field-group { min-width: 0; padding: 12px 13px; border: 1px solid var(--line); border-radius: 13px; background: #fff; }
.field-group label { display: block; color: #85849a; font-size: 9px; letter-spacing: 1.2px; font-weight: 800; margin-bottom: 9px; }
.field-control { display: flex; align-items: center; gap: 8px; color: var(--purple); min-width: 0; }
.field-control input, .field-control select {
  width: 100%; min-width: 0; border: 0; outline: 0; color: var(--ink);
  background: transparent; font-size: 13px; font-weight: 700;
}
.field-control input[type="date"] { font-size: 11px; }
.field-control input::placeholder { color: var(--ink); }
.field-control select { appearance: none; cursor: pointer; }
.field-control .select-chevron { flex-shrink: 0; color: var(--muted); }
.field-group > small { display: block; color: #9b9aae; font-size: 9px; margin-top: 7px; }
.swap-button {
  width: 33px; height: 33px; border-radius: 50%; border: 1px solid #e8e2ff;
  background: #f7f5ff; color: var(--purple); display: grid; place-items: center;
}
.search-button {
  min-height: 54px; display: flex; align-items: center; justify-content: center; gap: 8px;
  padding: 0 18px; border: 0; border-radius: 13px; background: var(--purple); color: white;
  font-size: 12px; font-weight: 700; white-space: nowrap; box-shadow: 0 8px 20px #7257e82b;
  transition: .2s;
}
.search-button:disabled { opacity: .65; cursor: wait; }
.search-note { display: flex; align-items: center; gap: 7px; color: #9694a8; font-size: 10px; margin: 17px 0 0; }
.search-note svg { color: #40a989; }

.notice { max-width: 1236px; margin: 18px auto 0; border-radius: 12px; padding: 14px 18px; font-size: 13px; }
.notice-info { color: #6b4b00; background: #fff8e7; border: 1px solid #f4e3b4; }
.notice-error { color: #a33848; background: #fff0f1; border: 1px solid #f6d5d9; }
.results-section, .destinations-section { max-width: 1236px; margin: 65px auto 0; }
.section-heading-row { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 24px; }
.section-heading-row h2 { font-size: 26px; }
.section-heading-row p { color: var(--muted); font-size: 12px; margin: 8px 0 0; }
.result-count { color: var(--purple); background: var(--purple-pale); padding: 9px 13px; border-radius: 10px; font-size: 11px; font-weight: 700; }
.flight-results { display: grid; gap: 13px; }
.flight-card {
  display: grid; grid-template-columns: 1fr 1.5fr .8fr; gap: 20px; align-items: center;
  background: white; border: 1px solid var(--line); border-radius: 18px; padding: 22px 24px;
}
.airline-info { display: flex; align-items: center; gap: 12px; }
.airline-mark { display: grid; place-items: center; width: 44px; height: 44px; background: var(--purple-pale); color: var(--purple); border-radius: 13px; }
.airline-info strong, .airline-info small { display: block; }
.airline-info strong { font-size: 13px; }
.airline-info small { font-size: 10px; color: var(--muted); margin-top: 5px; }
.flight-timing { display: flex; align-items: center; justify-content: center; gap: 20px; }
.flight-timing > div:not(.flight-line) strong, .flight-timing > div:not(.flight-line) span { display: block; }
.flight-timing strong { font-family: 'Manrope', sans-serif; font-size: 22px; }
.flight-timing > div:not(.flight-line) span { font-size: 11px; color: var(--muted); margin-top: 4px; }
.flight-line { flex: 1; min-width: 65px; display: flex; align-items: center; gap: 6px; color: var(--purple); }
.flight-line small { display: flex; align-items: center; gap: 4px; font-size: 9px; color: var(--muted); white-space: nowrap; }
.flight-line span { flex: 1; border-top: 1px dashed #c8c0ed; }
.flight-price { border-left: 1px solid var(--line); padding-left: 25px; display: flex; flex-direction: column; align-items: flex-end; gap: 5px; }
.flight-price small, .flight-price span { color: var(--muted); font-size: 10px; }
.flight-price strong { font-family: 'Manrope', sans-serif; font-size: 22px; }
.empty-results { padding: 45px; text-align: center; background: white; border: 1px solid var(--line); border-radius: 18px; color: var(--muted); }
.empty-results svg { color: var(--purple); }
.empty-results h3 { color: var(--ink); margin-bottom: 5px; }
.empty-results p { font-size: 13px; }

.destinations-section { margin-top: 77px; }
.text-link { display: inline-flex; align-items: center; gap: 8px; color: var(--purple); font-size: 12px; font-weight: 700; padding-bottom: 4px; }
.destination-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
.destination-card {
  height: 265px; position: relative; overflow: hidden; padding: 0; border: 0;
  border-radius: 20px; background: #d9d5e9; text-align: left; color: white;
}
.destination-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s; }
.destination-card:hover img { transform: scale(1.05); }
.destination-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, #10102505 20%, #101025b8 100%); }
.destination-label { position: absolute; top: 16px; left: 16px; padding: 8px 11px; background: #ffffffeb; color: var(--ink); border-radius: 20px; font-size: 10px; font-weight: 700; }
.destination-details { position: absolute; left: 20px; right: 20px; bottom: 19px; display: flex; justify-content: space-between; align-items: center; }
.destination-details strong, .destination-details small { display: block; }
.destination-details strong { font-family: 'Manrope', sans-serif; font-size: 22px; }
.destination-details small { font-size: 10px; opacity: .83; margin-top: 4px; }
.destination-arrow { width: 39px; height: 39px; border-radius: 50%; background: white; color: var(--purple); display: grid; place-items: center; }

.benefits-section {
  max-width: 1236px; margin: 67px auto 0; padding: 27px 0;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;
  border-top: 1px solid #eae7f3; border-bottom: 1px solid #eae7f3;
}
.benefit-item { display: flex; align-items: center; gap: 14px; }
.benefit-icon { width: 47px; height: 47px; border-radius: 15px; background: var(--purple-pale); color: var(--purple); display: grid; place-items: center; flex-shrink: 0; }
.benefit-item strong { font-size: 12px; }
.benefit-item p { color: var(--muted); font-size: 10px; margin: 5px 0 0; }
.site-footer {
  max-width: 1320px; margin: auto; min-height: 100px; padding: 28px 42px;
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
}
.footer-brand { font-size: 17px; }
.footer-brand .brand-icon { width: 33px; height: 33px; border-radius: 10px; }
.site-footer p, .site-footer > span { color: var(--muted); font-size: 11px; }

@media (max-width: 1280px) {
  .search-section, .results-section, .destinations-section, .benefits-section, .notice { margin-left: 32px; margin-right: 32px; }
  .flight-form { grid-template-columns: 1fr 30px 1fr 1fr 1fr; }
  .search-button { grid-column: 1 / -1; }
}
@media (max-width: 900px) {
  .site-header { padding: 0 25px; height: 74px; }
  .main-nav { gap: 18px; }
  .header-actions { gap: 12px; }
  .header-cta { padding: 12px; }
  .hero { padding: 38px 28px 48px; gap: 22px; grid-template-columns: 1fr 1fr; }
  .hero h1 { font-size: 42px; letter-spacing: -2px; }
  .hero-photo { height: 330px; }
  .hero-stats { gap: 16px; }
  .floating-card-top { left: -4px; }
  .search-section, .results-section, .destinations-section, .benefits-section, .notice { margin-left: 24px; margin-right: 24px; }
  .flight-card { grid-template-columns: 1fr 1.4fr; }
  .flight-price { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); padding: 14px 0 0; flex-direction: row; align-items: center; justify-content: space-between; }
}
@media (max-width: 650px) {
  .site-header { height: 70px; padding: 0 19px; }
  .brand { font-size: 19px; }
  .mobile-menu-button { display: grid; place-items: center; margin-left: auto; }
  .main-nav {
    display: none; position: absolute; top: 65px; left: 14px; right: 14px; z-index: 10;
    background: white; border: 1px solid var(--line); box-shadow: 0 12px 35px #20183d16;
    border-radius: 15px; padding: 18px; flex-direction: column; align-items: stretch; gap: 0;
  }
  .main-nav.nav-open { display: flex; }
  .main-nav a { padding: 12px; }
  .header-actions { display: none; }
  .hero { padding: 30px 20px 38px; display: flex; flex-direction: column; align-items: stretch; gap: 32px; margin-top: 0; }
  .hero h1 { font-size: clamp(39px, 10vw, 51px); letter-spacing: -2px; margin-top: 18px; }
  .hero-description { font-size: 13px; }
  .hero-actions { gap: 17px; }
  .hero-stats { margin-top: 29px; gap: 19px; }
  .hero-stats strong { font-size: 11px; }
  .hero-stats span { font-size: 9px; }
  .hero-visual { padding: 0 4px 10px; }
  .hero-photo { height: 275px; border-radius: 25px 25px 25px 70px; }
  .floating-card { padding: 10px 12px; }
  .floating-card-top { top: 20px; left: -2px; }
  .floating-card-bottom { right: -3px; bottom: 24px; }
  .search-section, .results-section, .destinations-section, .benefits-section, .notice { margin-left: 16px; margin-right: 16px; }
  .search-section { padding: 22px 17px 18px; border-radius: 19px; }
  .search-heading h2 { font-size: 22px; }
  .flight-form { display: grid; grid-template-columns: 1fr 34px 1fr; gap: 9px; }
  .route-field { min-width: 0; }
  .field-group { padding: 11px 9px; }
  .field-control { gap: 5px; }
  .field-control svg { width: 15px; flex-shrink: 0; }
  .field-control input, .field-control select { font-size: 12px; }
  .field-control input[type="date"] { font-size: 10px; }
  .date-field, .passenger-field { grid-column: span 1; }
  .swap-button { grid-column: 2; grid-row: 1; justify-self: center; z-index: 1; }
  .route-field:first-child { grid-column: 1; }
  .route-field:nth-of-type(3) { grid-column: 3; }
  .search-button { grid-column: 1 / -1; }
  .section-heading-row { align-items: flex-start; }
  .section-heading-row h2 { font-size: 22px; }
  .section-heading-row p { line-height: 1.6; }
  .results-section, .destinations-section { margin-top: 49px; }
  .flight-card { grid-template-columns: 1fr; padding: 18px; gap: 18px; }
  .flight-timing { justify-content: space-between; gap: 12px; }
  .flight-price { grid-column: auto; }
  .flight-price strong { font-size: 20px; }
  .destination-grid { grid-template-columns: 1fr; gap: 14px; }
  .destination-card { height: 235px; }
  .benefits-section { grid-template-columns: 1fr; gap: 21px; margin-top: 48px; }
  .site-footer { padding: 25px 20px; flex-wrap: wrap; }
  .site-footer p { order: 3; flex-basis: 100%; margin: 0; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
}

/* AeroBook passenger booking layout fixes */
#passenger-details {
  scroll-margin-top: 32px;
  color: #f8fafc;
}

#passenger-details .flight-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(210px, 0.65fr);
  align-items: center;
  gap: 24px;
  padding: 28px;
  background: #ffffff;
  color: #172033;
  border: 1px solid #e5e7ef;
  border-radius: 18px;
  box-sizing: border-box;
}

#passenger-details .flight-timing {
  min-width: 0;
  width: 100%;
}

#passenger-details .flight-timing strong,
#passenger-details .flight-timing span,
#passenger-details .flight-price strong,
#passenger-details .flight-price small,
#passenger-details .flight-price span {
  color: #172033;
}

#passenger-details .flight-price {
  min-width: 0;
  border-left: 1px solid #e5e7ef;
  padding: 12px 0 12px 24px;
  align-items: flex-start;
  overflow-wrap: anywhere;
}

#passenger-details .flight-price strong {
  font-size: clamp(22px, 2.5vw, 30px);
  line-height: 1.3;
}

#passenger-details .flight-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  width: 100%;
  margin-top: 22px;
  padding: 26px;
  box-sizing: border-box;
  background: #ffffff;
  border: 1px solid #e5e7ef;
  border-radius: 18px;
}

#passenger-details .flight-form .field-group {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  gap: 9px;
}

#passenger-details .flight-form .field-group label {
  color: #555d73;
  font-size: 11px;
  letter-spacing: 0.08em;
}

#passenger-details .flight-form .field-control {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  min-height: 48px;
  padding: 0 13px;
  box-sizing: border-box;
  background: #f8f9fc;
  border: 1px solid #dfe3ed;
  border-radius: 10px;
}

#passenger-details .flight-form .field-control input {
  display: block;
  width: 100%;
  min-width: 0;
  height: 46px;
  padding: 0;
  box-sizing: border-box;
  color: #172033;
  background: transparent;
  border: 0;
  outline: none;
  font: inherit;
}

#passenger-details .flight-form .field-control:focus-within {
  border-color: #7655ed;
  box-shadow: 0 0 0 3px rgba(118, 85, 237, 0.12);
}

#passenger-details .flight-form > button {
  grid-column: 1 / -1;
  width: 100%;
  min-height: 50px;
  justify-content: center;
  border-radius: 11px;
}

#passenger-details .flight-form > button:disabled {
  opacity: 0.65;
  cursor: wait;
}

#passenger-details .notice {
  margin-top: 16px;
  overflow-wrap: anywhere;
}

@media (max-width: 700px) {
  #passenger-details .flight-card {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    padding: 18px;
  }

  #passenger-details .flight-price {
    border-left: 0;
    border-top: 1px solid #e5e7ef;
    padding: 16px 0 0;
  }

  #passenger-details .flight-form {
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    padding: 18px;
  }
}
